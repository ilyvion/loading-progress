<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseLaboratory>true</UseLaboratory>
        <RootNamespace>ilyvion.LoadingProgress.Tests</RootNamespace>
        <AssemblyName>ilyvion.LoadingProgress.Tests</AssemblyName>
    </PropertyGroup>
    <!--
        Dev-only test assembly, run in-game via DevTools
        (https://github.com/ilyvion/SmashPhil-DevTools.git).
        It builds into the same <version>/Assemblies folder as the mod assembly, next to the
        DevTools.dll that the DevTools reference below also builds into that folder.

        It's listed in ilyvion.LoadingProgress.sln so it always builds locally (default
        Configuration is Debug), but ilyvion.LoadingProgress.sln deliberately omits a
        Release|Any CPU.Build.0 line for this project's GUID, so a Release-configuration build
        (what CI/release always use) skips building it, and DevTools, entirely; neither DLL lands
        in a shipped release.
    -->
    <ItemGroup>
        <Publicize Include="Assembly-CSharp:Verse.LongEventHandler.UpdateCurrentEnumeratorEvent" />
        <Publicize Include="Assembly-CSharp:Verse.LongEventHandler.UpdateCurrentAsynchronousEvent" />
        <Publicize Include="Assembly-CSharp:Verse.LongEventHandler.UpdateCurrentSynchronousEvent" />
        <Publicize Include="Assembly-CSharp:Verse.LongEventHandler+QueuedLongEvent" />
        <Publicize Include="Assembly-CSharp:Verse.LongEventHandler.toExecuteWhenFinished" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ilyvion.LoadingProgress\ilyvion.LoadingProgress.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <!--
        DevTools' own OutDir is relative to its clone location, so it's redirected to this mod's
        1.6/Assemblies folder.
    -->
    <ItemGroup>
        <ProjectReference
            Include="$(ProjectDependenciesBasePath)\Third-Party\DevTools\DevTools\DevTools.csproj"
            AdditionalProperties="OutDir=$(MSBuildThisFileDirectory)..\..\1.6\Assemblies\"
        >
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
</Project>
